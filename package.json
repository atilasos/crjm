{
  "name": "jogos-matematicos-crjm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site de treino para o Campeonato Regional de Jogos Matemáticos da Madeira - 1.º Ciclo",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun run build && NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "e2e:learner-core": "bun run scripts/e2e-learner-core-v1.ts",
    "baseline:dominorio": "bun run scripts/dominorio-baseline.ts",
    "baseline:atari-go": "bun run scripts/atari-go-ladder-baseline.ts",
    "ai:latency": "bun run scripts/ai-latency.ts --profile smoke",
    "ai:ladder": "bun run scripts/ai-ladder.ts --profile classroom",
    "ai:arena:atari-go": "bun run scripts/atari-go-arena.ts",
    "ai:budget:atari-go": "bun run scripts/atari-go-wasm-budget.ts",
    "ai:arena:produto": "bun run scripts/produto-arena.ts",
    "classroom:smoke": "bun run build -- --skip-wasm && bun run scripts/classroom-smoke.ts && bun run scripts/classroom-ui-smoke.ts",
    "classroom:ui-smoke": "bun run build -- --skip-wasm && bun run scripts/classroom-ui-smoke.ts",
    "hardening:f3.1": "bun run scripts/hardening-f3_1.ts",
    "hardening:f3.2": "bun run scripts/hardening-f3_2.ts",
    "tournament": "bun run build && bun run src/server/tournament-server.ts",
    "tournament:dev": "bun run build && bun --hot src/server/tournament-server.ts",
    "screenshots": "bun run scripts/capture-screenshots.ts",
    "screenshots:local": "BASE_URL=http://localhost:3000 bun run scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.57.0"
  }
}
